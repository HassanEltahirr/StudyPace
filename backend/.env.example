# Copy this file to .env and fill in your values.
# Never commit .env to git.

STUDYPACE_ENV=development

# Claude is optional. Leave empty unless you want Claude-generated summaries/questions.
ANTHROPIC_API_KEY=

# Gemini 2.0 Flash — deck summaries, practice exam questions, topic cleanup.
# Free tier (1500 req/day), key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API v3 — lecture video recommendations after a deck is finished.
# Free tier (10000 units/day, each search costs 100), key from Google Cloud Console.
YOUTUBE_API_KEY=

# Auth — CHANGE THESE before deploying
SECRET_KEY=generate-a-long-random-string-here-min-32-chars
STUDYPACE_USERNAME=admin
STUDYPACE_PASSWORD=changeme
STUDYPACE_LOCAL_ADMIN_ENABLED=true

# Optional Google sign-in
# Create an OAuth Web client in Google Cloud and add:
#   Authorized JavaScript origin: http://localhost:5173
# GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Optional access limits:
# GOOGLE_ALLOWED_EMAILS=hassan@example.com,friend@example.com
# GOOGLE_ALLOWED_DOMAIN=example.com

# Optional Supabase Postgres.
# Use Supabase's pooled connection string in production.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional Cloudflare R2 file storage.
# When these are set, uploaded PDFs and rendered slide images are stored in R2.
# STUDYPACE_STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=studypace-uploads
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Optional Twilio outbound call reminders (Arabic Gulf voice).
# Without these the system runs in demo mode (no real calls placed).
# Get credentials at https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx          # your Twilio number
# TWILIO_AR_VOICE=Polly.Hala-Neural        # or Polly.Zayd-Neural
# TWILIO_CALL_TIME=08:00                   # HH:MM server local time
# TWILIO_WEBHOOK_BASE_URL=https://xxxx.ngrok-free.app  # public URL for <Gather> callbacks

# Optional ElevenLabs — Emirati Arabic voice (overrides Polly <Say> when set)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional — defaults shown
# DATABASE_URL=sqlite:////app/data/studypace_local.db
# STUDYPACE_DATA_DIR=/app/data
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# MAX_UPLOAD_MB=50
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:mini
# CLAUDE_MODEL=claude-haiku-4-5-20251001
